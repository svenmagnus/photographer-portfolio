---
export const prerender = true

import CmsSlugPage from '../components/pages/CmsSlugPage.astro'
import { slugStaticPaths } from '../lib/staticPaths'

export async function getStaticPaths() {
  return slugStaticPaths('de')
}

const slug = Astro.params.slug ?? ''
---

<CmsSlugPage locale="de" slug={slug} />
